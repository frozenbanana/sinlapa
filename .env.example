# Copy to .dev.vars for local `npm run dev` (Wrangler loads .dev.vars / .env).
# In Cloudflare Pages: Settings → Variables and Secrets.

# Where booking + catering form submissions are delivered
NOTIFY_EMAIL=info@sinlapa.se

# Optional From address (must be verified in Resend)
FROM_EMAIL=Sinlapa Webb <onboarding@resend.dev>

# Resend API key — https://resend.com
RESEND_API_KEY=

# Password for /admin (use Cloudflare Access in production when ready)
ADMIN_PASSWORD=changeme

# Production site URL (used in structured data and AI-readable files like llms.txt)
SITE_URL=https://sinlapa.se

# Optional exact map coordinates (lat, lng) for the Restaurant schema — from Google Business Profile
SITE_LAT=
SITE_LNG=

# Cloudflare Web Analytics beacon token — set to start collecting site visits (leave empty for none)
WEB_ANALYTICS_TOKEN=
